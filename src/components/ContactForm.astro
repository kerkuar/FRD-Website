---
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const reasonOptions: { value: string; key: any }[] = [
  { value: 'staytouch', key: 'contact.form.reason.staytouch' },
  { value: 'collab',    key: 'contact.form.reason.collab' },
  { value: 'speech',    key: 'contact.form.reason.speech' },
  { value: 'workshop',  key: 'contact.form.reason.workshop' },
  { value: 'campaign',  key: 'contact.form.reason.campaign' },
  { value: 'press',     key: 'contact.form.reason.press' },
  { value: 'other',     key: 'contact.form.reason.other' },
];

const successPath = (lang === 'it' ? '/contatti?ok=1' : '/en/contact?ok=1');
---

<form
  name="contact"
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  action={successPath}
  class="grid gap-4"
>
  <!-- Required by Netlify Forms -->
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden">
    <label>Don’t fill this out: <input name="bot-field" /></label>
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1 block text-sm font-medium text-ink-800">{t('contact.form.name')}</span>
      <input
        type="text" name="name" required autocomplete="name"
        class="w-full rounded-xl border border-ink-900/15 bg-cream-50 px-4 py-2.5
               focus:border-clay-600 focus:outline-none focus:ring-2 focus:ring-clay-600/20"
      />
    </label>
    <label class="block">
      <span class="mb-1 block text-sm font-medium text-ink-800">{t('contact.form.email')}</span>
      <input
        type="email" name="email" required autocomplete="email"
        class="w-full rounded-xl border border-ink-900/15 bg-cream-50 px-4 py-2.5
               focus:border-clay-600 focus:outline-none focus:ring-2 focus:ring-clay-600/20"
      />
    </label>
  </div>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-ink-800">{t('contact.form.org')}</span>
    <input
      type="text" name="organisation"
      class="w-full rounded-xl border border-ink-900/15 bg-cream-50 px-4 py-2.5
             focus:border-clay-600 focus:outline-none focus:ring-2 focus:ring-clay-600/20"
    />
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-ink-800">{t('contact.form.reason')}</span>
    <select
      name="reason" required
      class="w-full rounded-xl border border-ink-900/15 bg-cream-50 px-4 py-2.5
             focus:border-clay-600 focus:outline-none focus:ring-2 focus:ring-clay-600/20"
    >
      <option value="" disabled selected>{t('contact.form.reason.placeholder')}</option>
      {reasonOptions.map(o => (<option value={o.value}>{t(o.key)}</option>))}
    </select>
  </label>

  <label class="block">
    <span class="mb-1 block text-sm font-medium text-ink-800">{t('contact.form.message')}</span>
    <textarea
      name="message" required rows="6"
      class="w-full rounded-xl border border-ink-900/15 bg-cream-50 px-4 py-2.5
             focus:border-clay-600 focus:outline-none focus:ring-2 focus:ring-clay-600/20"
    ></textarea>
  </label>

  <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-xs text-ink-500 max-w-md">{t('contact.form.privacy')}</p>
    <button type="submit" class="btn-primary">{t('contact.form.send')}</button>
  </div>
</form>
