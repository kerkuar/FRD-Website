---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props {
  article: CollectionEntry<'articles'>;
  lang: Lang;
}

const { article, lang } = Astro.props;
const t = useTranslations(lang);
const data = article.data;

const title = lang === 'en' && data.titleEn ? data.titleEn : data.title;
const summary = lang === 'en' && data.summaryEn ? data.summaryEn : data.summary;
const date = data.date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { year: 'numeric', month: 'long' });
---

<article class="card flex flex-col gap-3">
  <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-ink-500">
    <span class="font-medium text-clay-700">{data.outlet}</span>
    <span aria-hidden>·</span>
    <time datetime={data.date.toISOString()}>{date}</time>
    <span aria-hidden>·</span>
    <span>{data.lang.toUpperCase()}</span>
  </div>

  <h3 class="font-serif text-xl leading-snug">
    <a href={data.url} target="_blank" rel="noopener noreferrer" class="hover:text-clay-700">
      {title}
    </a>
  </h3>

  <p class="text-sm leading-relaxed text-ink-700 line-clamp-4">{summary}</p>

  <div class="mt-auto pt-2">
    <a href={data.url} target="_blank" rel="noopener noreferrer"
       class="text-sm font-medium text-clay-700 hover:text-clay-800">
      {t('articles.read')} ↗
    </a>
  </div>
</article>
