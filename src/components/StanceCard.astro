---
interface Props {
  number: number;
  title: string;
  body: string;
  tag?: string;
}
const { number, title, body, tag } = Astro.props;
---

<article class="rounded-2xl border border-ink-900/8 bg-cream-50 p-6 sm:p-7">
  <div class="flex items-baseline gap-3">
    <span class="font-serif text-3xl font-medium text-clay-600 tabular-nums">
      {String(number).padStart(2, '0')}
    </span>
    {tag && <span class="eyebrow">{tag}</span>}
  </div>
  <h3 class="mt-2 font-serif text-2xl leading-tight text-ink-900">{title}</h3>
  <p class="mt-3 text-base leading-relaxed text-ink-800">{body}</p>
</article>
