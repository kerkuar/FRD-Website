---
/**
 * "Who I am in two minutes" video block. Renders only when a YouTube ID is set
 * in src/data/campaign.json → video.youtubeId.
 */
import { useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import campaign from '@/data/campaign.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const video = campaign.video;
---

{video.youtubeId && (
  <section class="bg-ink-900 clip-slant-top">
    <div class="container-page py-16 md:py-24">
      <p class="eyebrow text-sage-400">{t('video.kicker')}</p>
      <h2 class="mt-2 max-w-3xl text-3xl text-white md:text-5xl">{video.title[lang]}</h2>
      <div class="mt-8 overflow-hidden rounded-xl border-2 border-white/10 shadow-[8px_8px_0_0_rgb(255_197_61)]">
        <div class="aspect-video">
          <iframe
            class="h-full w-full"
            src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
            title={video.title[lang]}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>
)}
