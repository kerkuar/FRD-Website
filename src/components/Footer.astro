---
import { useTranslations, localizedPath, alternateLangPath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = alternateLangPath(Astro.url, lang);
const year = new Date().getFullYear();

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/francescaromana_dantuono' },
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/in/thisisfrd/' },
  { label: 'Substack',  href: 'https://substack.com/@francescaromanadantuono' },
];
---

<footer class="mt-24 border-t border-ink-900/8 bg-cream-100">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-serif text-xl uppercase leading-snug text-ink-900">
        Francesca Romana <span class="text-clay-600">D&rsquo;Antuono</span>
      </p>
      <p class="mt-3 max-w-xs text-sm text-ink-600">{t('footer.tagline')}</p>
    </div>

    <nav aria-label="footer" class="text-sm">
      <p class="eyebrow mb-3">{lang === 'it' ? 'Sito' : 'Site'}</p>
      <ul class="space-y-1.5">
        <li><a class="link-underline" href={localizedPath('about', lang)}>{t('nav.about')}</a></li>
        <li><a class="link-underline" href={localizedPath('positions', lang)}>{t('nav.positions')}</a></li>
        <li><a class="link-underline" href={localizedPath('articles', lang)}>{t('nav.articles')}</a></li>
        <li><a class="link-underline" href={localizedPath('speeches', lang)}>{t('nav.speeches')}</a></li>
        <li><a class="link-underline" href={localizedPath('participate', lang)}>{t('nav.participate')}</a></li>
        <li><a class="link-underline" href={localizedPath('contact', lang)}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <div class="text-sm">
      <p class="eyebrow mb-3">{lang === 'it' ? 'Altrove' : 'Elsewhere'}</p>
      <ul class="space-y-1.5">
        {socials.map(s => (
          <li>
            <a class="link-underline" href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>
          </li>
        ))}
        <li class="pt-2">
          <a class="link-underline" href="mailto:francescaromanadantuono.frd@gmail.com">
            francescaromanadantuono.frd@gmail.com
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-900/8">
    <div class="container-page flex flex-col-reverse gap-3 py-5 text-xs text-ink-500 md:flex-row md:items-center md:justify-between">
      <p>© {year} Francesca Romana D&rsquo;Antuono. {t('footer.rights')}</p>
      <p class="flex items-center gap-3">
        <a href={localizedPath('privacy', lang)} class="link-underline">{t('footer.privacy')}</a>
        <span>{t('footer.colophon')}</span>
        <a href={alt.path} hreflang={alt.lang} class="link-underline uppercase tracking-wider">{t('lang.switch')}</a>
      </p>
    </div>
  </div>
</footer>
