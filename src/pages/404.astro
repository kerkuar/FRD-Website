---
import Base from '@layouts/Base.astro';
const lang = 'it' as const;
---
<Base title="404" lang={lang} noindex>
  <section class="container-page py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-serif text-5xl">Pagina non trovata</h1>
    <p class="mt-4 text-ink-700">La pagina che stai cercando non esiste o è stata spostata.</p>
    <p class="mt-8">
      <a class="btn-primary" href="/">Torna alla home</a>
    </p>
  </section>
</Base>
