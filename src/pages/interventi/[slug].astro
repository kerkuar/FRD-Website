---
import Base from '@layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations } from '@i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('speeches');
  return all.map((s) => ({ params: { slug: s.slug }, props: { speech: s } }));
}

interface Props { speech: CollectionEntry<'speeches'>; }
const { speech } = Astro.props;
const { Content } = await speech.render();
const d = speech.data;

const lang = 'it' as const;
const t = useTranslations(lang);

const title = d.title;
const dateLabel = d.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} lang={lang} description={d.summary}>
  <article class="container-page pt-12 pb-20 md:pt-20">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">
        {d.event} · <time datetime={d.date.toISOString()}>{dateLabel}</time>
        {d.location ? ` · ${d.location}` : ''}
      </p>
      <h1 class="mt-3 font-serif text-3xl leading-tight md:text-4xl">{title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-700">{d.summary}</p>
    </header>

    <div class="mx-auto mt-10 max-w-4xl">
      {d.type === 'youtube' && d.youtubeId && (
        <div class="aspect-video overflow-hidden rounded-2xl border border-ink-900/8 bg-ink-900">
          <iframe
            class="h-full w-full"
            src={`https://www.youtube-nocookie.com/embed/${d.youtubeId}`}
            title={title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      )}
      {d.type === 'hosted' && d.videoSrc && (
        <video controls class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-900/8 bg-ink-900">
          <source src={d.videoSrc} />
        </video>
      )}
      {d.type === 'hosted' && !d.videoSrc && d.audioSrc && (
        <audio controls class="w-full">
          <source src={d.audioSrc} />
        </audio>
      )}
    </div>

    {d.transcript && (
      <section class="mx-auto mt-12 max-w-prose">
        <h2 class="font-serif text-2xl">Trascrizione</h2>
        <p class="mt-4 whitespace-pre-line text-ink-800">{d.transcript}</p>
      </section>
    )}

    <div class="mx-auto mt-12 max-w-prose text-ink-800 leading-relaxed">
      <Content />
    </div>
  </article>
</Base>
