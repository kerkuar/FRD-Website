---
import Base from '@layouts/Base.astro';
import SpeechCard from '@components/SpeechCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '@i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const speeches = (await getCollection('speeches', (s) => !s.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Speeches" lang={lang} description="Public speeches by Francesca Romana D'Antuono.">
  <section class="container-page pt-12 pb-10 md:pt-20">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">{t('speeches.title')}</p>
      <h1 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">{t('speeches.title')}</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-700">{t('speeches.lead')}</p>
    </header>
  </section>

  <section class="container-page pb-24">
    {speeches.length === 0 ? (
      <p class="mx-auto max-w-prose text-center text-ink-600">{t('speeches.empty')}</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {speeches.map((s) => (<li><SpeechCard speech={s} lang={lang} /></li>))}
      </ul>
    )}
  </section>
</Base>
