---
import Base from '@layouts/Base.astro';
import StanceCard from '@components/StanceCard.astro';
import InstagramFeed from '@components/InstagramFeed.astro';
import { useTranslations } from '@i18n/utils';
import { stances } from '@/data/stances';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<Base title="Positions" lang={lang} description="Francesca Romana D'Antuono's positions on today's issues.">
  <section class="container-page pt-12 pb-10 md:pt-20">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">{t('positions.title')}</p>
      <h1 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">{t('positions.title')}</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-700">{t('positions.lead')}</p>
      <p class="mt-3 text-xs text-ink-500">
        <!-- DRAFT — to be reviewed by FRD -->
        {t('positions.disclaimer')}
      </p>
    </header>
  </section>

  <section class="container-page pb-20">
    <ul class="grid gap-5 md:grid-cols-2">
      {stances.map((s, i) => (
        <li>
          <StanceCard
            number={i + 1}
            tag={s.tag.en}
            title={s.title.en}
            body={s.body.en}
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page pb-20">
    <div class="mb-6">
      <h2 class="font-serif text-3xl">{t('positions.social.title')}</h2>
      <p class="mt-2 text-ink-700 max-w-2xl">{t('positions.social.body')}</p>
    </div>
    <InstagramFeed lang={lang} />
  </section>
</Base>
