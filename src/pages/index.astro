---
import Base from '@layouts/Base.astro';
import { useTranslations, localizedPath } from '@i18n/utils';
import { getCollection } from 'astro:content';
import ArticleCard from '@components/ArticleCard.astro';
import PhotoFrame from '@components/PhotoFrame.astro';
import NewsletterSignup from '@components/NewsletterSignup.astro';
import PressSection from '@components/PressSection.astro';
import VideoBlock from '@components/VideoBlock.astro';
import campaign from '@/data/campaign.json';

const lang = 'it' as const;
const t = useTranslations(lang);
const isCampaign = campaign.mode === 'campaign';

const allArticles = (await getCollection('articles', (a) => !a.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = allArticles.slice(0, 3);
---

<Base title="Francesca Romana D'Antuono" lang={lang}>
  <!-- Hero -->
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24">
    <div class="grid items-center gap-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="eyebrow">{t('home.hero.kicker')}</p>
        {isCampaign ? (
          <h1 class="mt-4 text-5xl sm:text-6xl md:text-7xl">
            {campaign.campaignMode.headline[lang]}
          </h1>
        ) : (
          <h1 class="mt-4 text-5xl sm:text-6xl md:text-7xl">
            <!-- DRAFT — to be reviewed by FRD -->
            Costruire l’Europa <span class="highlight-tilt"><span>che ancora non c’è.</span></span>
          </h1>
        )}
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-700">
          {isCampaign ? campaign.campaignMode.lead[lang] : t('home.hero.lead')}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          {isCampaign ? (
            <a class="btn-gold" href={localizedPath('participate', lang)}>{campaign.campaignMode.ctaLabel[lang]}</a>
          ) : (
            <a class="btn-primary" href={localizedPath('about', lang)}>{t('home.hero.cta.primary')}</a>
          )}
          <a class="btn-outline" href={localizedPath('positions', lang)}>{t('home.hero.cta.secondary')}</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <PhotoFrame src="/photos/portrait-hero.jpg" alt="Francesca Romana D'Antuono — ritratto" ratio="portrait" rounded="3xl" />
      </div>
    </div>
  </section>

  <VideoBlock lang={lang} />

  <PressSection lang={lang} />

  <!-- Three feature blocks -->
  <section class="container-page py-12 md:py-16">
    <div class="grid gap-5 md:grid-cols-3">
      <a class="card group" href={localizedPath('about', lang)}>
        <p class="eyebrow">01</p>
        <h2 class="mt-2 font-serif text-2xl">{t('home.feat.about.title')}</h2>
        <p class="mt-2 text-ink-700">{t('home.feat.about.body')}</p>
        <p class="mt-4 text-sm font-medium text-clay-700 group-hover:text-clay-800">→</p>
      </a>
      <a class="card group" href={localizedPath('positions', lang)}>
        <p class="eyebrow">02</p>
        <h2 class="mt-2 font-serif text-2xl">{t('home.feat.positions.title')}</h2>
        <p class="mt-2 text-ink-700">{t('home.feat.positions.body')}</p>
        <p class="mt-4 text-sm font-medium text-clay-700 group-hover:text-clay-800">→</p>
      </a>
      <a class="card group" href={localizedPath('speeches', lang)}>
        <p class="eyebrow">03</p>
        <h2 class="mt-2 font-serif text-2xl">{t('home.feat.speeches.title')}</h2>
        <p class="mt-2 text-ink-700">{t('home.feat.speeches.body')}</p>
        <p class="mt-4 text-sm font-medium text-clay-700 group-hover:text-clay-800">→</p>
      </a>
    </div>
  </section>

  <!-- Latest articles -->
  {latest.length > 0 && (
    <section class="container-page py-12 md:py-16">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-serif text-3xl md:text-4xl">{t('home.articles.title')}</h2>
        <a class="text-sm font-medium text-clay-700 hover:text-clay-800" href={localizedPath('articles', lang)}>{t('home.articles.cta')} →</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {latest.map((a) => (<ArticleCard article={a} lang={lang} />))}
      </div>
    </section>
  )}

  <!-- Newsletter — the campaign's key conversion block -->
  <NewsletterSignup lang={lang} />

  <!-- Closing CTA -->
  <section class="container-page py-16 md:py-24">
    <div class="rounded-xl border-2 border-ink-900/10 bg-cream-100 p-8 md:p-14">
      <div class="grid items-center gap-8 md:grid-cols-12">
        <div class="md:col-span-8">
          <p class="eyebrow">04</p>
          <h2 class="mt-2 text-3xl md:text-4xl">{t('home.cta.title')}</h2>
          <p class="mt-3 max-w-2xl text-lg text-ink-700">{t('home.cta.body')}</p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <a class="btn-primary" href={localizedPath('contact', lang)}>{t('home.cta.button')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
