---
import Base from '@layouts/Base.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '@i18n/utils';

const lang = 'it' as const;
const t = useTranslations(lang);

const articles = (await getCollection('articles', (a) => !a.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const years = Array.from(new Set(articles.map((a) => a.data.date.getFullYear()))).sort((a, b) => b - a);
const outlets = Array.from(new Set(articles.map((a) => a.data.outlet))).sort();

const pillClass = "rounded-full border border-ink-900/15 px-3 py-1.5 text-sm hover:border-ink-900 aria-pressed:bg-ink-900 aria-pressed:text-cream-50 aria-pressed:border-ink-900";
---

<Base title="Articoli" lang={lang} description="Articoli pubblicati da Francesca Romana D'Antuono.">
  <section class="container-page pt-12 pb-10 md:pt-20">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">{t('articles.title')}</p>
      <h1 class="mt-3 font-serif text-4xl leading-tight md:text-5xl">{t('articles.title')}</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-700">{t('articles.lead')}</p>
    </header>
  </section>

  <section class="container-page pb-24">
    {articles.length === 0 ? (
      <p class="mx-auto max-w-prose text-center text-ink-600">{t('articles.empty')}</p>
    ) : (
      <>
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="eyebrow">{t('articles.filter.year')}:</span>
          <button class={pillClass} data-filter-year="all">{t('articles.filter.all')}</button>
          {years.map((y) => (
            <button class={pillClass} data-filter-year={String(y)}>{y}</button>
          ))}
          <span class="ml-4 eyebrow">{t('articles.filter.outlet')}:</span>
          <select class="rounded-full border border-ink-900/15 bg-cream-50 px-3 py-1.5 text-sm" data-filter-outlet>
            <option value="all">{t('articles.filter.all')}</option>
            {outlets.map((o) => (<option value={o}>{o}</option>))}
          </select>
        </div>

        <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" id="articles-grid">
          {articles.map((a) => (
            <li data-year={a.data.date.getFullYear()} data-outlet={a.data.outlet}>
              <ArticleCard article={a} lang={lang} />
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
</Base>

<script is:inline>
  (function () {
    const yearButtons = document.querySelectorAll('[data-filter-year]');
    const outletSelect = document.querySelector('[data-filter-outlet]');
    const items = document.querySelectorAll('#articles-grid > li');
    let activeYear = 'all';
    let activeOutlet = 'all';
    function apply() {
      items.forEach(function (li) {
        const yearOk = activeYear === 'all' || li.dataset.year === activeYear;
        const outletOk = activeOutlet === 'all' || li.dataset.outlet === activeOutlet;
        li.style.display = yearOk && outletOk ? '' : 'none';
      });
    }
    yearButtons.forEach(function (b) {
      b.addEventListener('click', function () {
        yearButtons.forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
        b.setAttribute('aria-pressed', 'true');
        activeYear = b.dataset.filterYear || 'all';
        apply();
      });
      if (b.dataset.filterYear === 'all') b.setAttribute('aria-pressed', 'true');
    });
    if (outletSelect) {
      outletSelect.addEventListener('change', function () {
        activeOutlet = outletSelect.value;
        apply();
      });
    }
  })();
</script>
